generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// One row today ("School #1"), but every tenant-scoped table below already
// carries schoolId — see the SaaS conversion plan in the master doc (Section 5/8.7).
model School {
  id                 String   @id @default(cuid())
  name               String
  subdomain          String   @unique
  subscriptionPlan   String   @default("single_tenant")
  subscriptionStatus String   @default("active")
  trialEndsAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users User[]
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  PRINCIPAL
  TEACHER
  STUDENT
  PARENT
  ACCOUNTANT
  LIBRARIAN
  TRANSPORT_MANAGER
}

model User {
  id           String   @id @default(cuid())
  schoolId     String
  email        String
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school            School             @relation(fields: [schoolId], references: [id])
  refreshTokens      RefreshToken[]
  passwordResetOtps  PasswordResetOtp[]

  @@unique([schoolId, email])
  @@index([schoolId])
}

// Rotated on every refresh; tokenHash lets a stolen DB dump not be a stolen session.
model RefreshToken {
  id         String    @id @default(cuid())
  schoolId   String
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([schoolId])
  @@index([userId])
}

model PasswordResetOtp {
  id          String    @id @default(cuid())
  schoolId    String
  userId      String
  otpHash     String
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([schoolId])
  @@index([userId])
}

// Classes/Sections live inside a session so year-end promotion and repeated
// classes keep separate, correctly-dated records — see master doc Section 8.2.
model AcademicSession {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes Class[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Class {
  id                String   @id @default(cuid())
  schoolId          String
  academicSessionId String
  name              String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id])
  sections        Section[]
  subjects        Subject[]

  @@unique([academicSessionId, name])
  @@index([schoolId])
}

model Section {
  id        String   @id @default(cuid())
  schoolId  String
  classId   String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class Class @relation(fields: [classId], references: [id])

  @@unique([classId, name])
  @@index([schoolId])
}

model Subject {
  id        String   @id @default(cuid())
  schoolId  String
  classId   String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class Class @relation(fields: [classId], references: [id])

  @@unique([classId, name])
  @@index([schoolId])
}
