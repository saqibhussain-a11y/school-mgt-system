generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// One row today ("School #1"), but every tenant-scoped table below already
// carries schoolId — see the SaaS conversion plan in the master doc (Section 5/8.7).
model School {
  id                 String   @id @default(cuid())
  name               String
  subdomain          String   @unique
  subscriptionPlan   String   @default("single_tenant")
  subscriptionStatus String   @default("active")
  trialEndsAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users User[]
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  PRINCIPAL
  TEACHER
  STUDENT
  PARENT
  ACCOUNTANT
  LIBRARIAN
  TRANSPORT_MANAGER
}

model User {
  id           String   @id @default(cuid())
  schoolId     String
  email        String
  passwordHash String
  role         Role
  firstName    String   @default("")
  lastName     String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school            School             @relation(fields: [schoolId], references: [id])
  refreshTokens      RefreshToken[]
  passwordResetOtps  PasswordResetOtp[]
  student            Student?
  staff              Staff?
  guardian           Guardian?
  attendanceMarked   Attendance[]       @relation("AttendanceMarkedBy")
  announcements      Announcement[]     @relation("AnnouncementCreatedBy")
  leaveRequests      LeaveRequest[]     @relation("LeaveRequestApplicant")
  leaveReviews       LeaveRequest[]     @relation("LeaveRequestReviewer")

  @@unique([schoolId, email])
  @@index([schoolId])
}

// Rotated on every refresh; tokenHash lets a stolen DB dump not be a stolen session.
model RefreshToken {
  id         String    @id @default(cuid())
  schoolId   String
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([schoolId])
  @@index([userId])
}

model PasswordResetOtp {
  id          String    @id @default(cuid())
  schoolId    String
  userId      String
  otpHash     String
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([schoolId])
  @@index([userId])
}

// Classes/Sections live inside a session so year-end promotion and repeated
// classes keep separate, correctly-dated records — see master doc Section 8.2.
model AcademicSession {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes Class[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Class {
  id                String   @id @default(cuid())
  schoolId          String
  academicSessionId String
  name              String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  academicSession    AcademicSession     @relation(fields: [academicSessionId], references: [id])
  sections           Section[]
  subjects           Subject[]
  students           Student[]
  attendances        Attendance[]
  announcements      Announcement[]
  teacherAssignments TeacherAssignment[]
  timetableSlots     TimetableSlot[]

  @@unique([academicSessionId, name])
  @@index([schoolId])
}

model Section {
  id        String   @id @default(cuid())
  schoolId  String
  classId   String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class              Class               @relation(fields: [classId], references: [id])
  students           Student[]
  attendances        Attendance[]
  teacherAssignments TeacherAssignment[]
  timetableSlots     TimetableSlot[]

  @@unique([classId, name])
  @@index([schoolId])
}

model Subject {
  id        String   @id @default(cuid())
  schoolId  String
  classId   String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class          Class           @relation(fields: [classId], references: [id])
  timetableSlots TimetableSlot[]

  @@unique([classId, name])
  @@index([schoolId])
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

// Manual builder, not auto-generated (master doc V2 scope — AI-assisted
// auto-generation is a V5 stretch goal). startTime/endTime are "HH:mm"
// strings rather than a shared Period entity, since schools vary period
// lengths (e.g. a shorter period after lunch) — conflict detection in
// timetableSlot.service.ts does its own string-range overlap check.
model TimetableSlot {
  id        String    @id @default(cuid())
  schoolId  String
  classId   String
  sectionId String
  subjectId String
  staffId   String
  dayOfWeek DayOfWeek
  startTime String
  endTime   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  class   Class   @relation(fields: [classId], references: [id])
  section Section @relation(fields: [sectionId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  staff   Staff   @relation(fields: [staffId], references: [id])

  @@index([schoolId])
  @@index([sectionId, dayOfWeek])
  @@index([staffId, dayOfWeek])
}

enum StudentStatus {
  ACTIVE
  WITHDRAWN
}

enum StaffStatus {
  ACTIVE
  DEACTIVATED
}

enum GuardianRelationship {
  FATHER
  MOTHER
  GRANDPARENT
  LEGAL_GUARDIAN
  OTHER
}

// Withdrawal is a status change, never a row delete — historical attendance/
// grades/payments must stay attributable (master doc Section 8.1).
model Student {
  id             String        @id @default(cuid())
  schoolId       String
  userId         String        @unique
  admissionNo    String
  classId        String
  sectionId      String
  dob            DateTime
  admissionDate  DateTime      @default(now())
  previousSchool String?
  medicalInfo    String?
  status         StudentStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user        User              @relation(fields: [userId], references: [id])
  class       Class             @relation(fields: [classId], references: [id])
  section     Section           @relation(fields: [sectionId], references: [id])
  guardians   StudentGuardian[]
  attendances Attendance[]

  @@unique([schoolId, admissionNo])
  @@index([schoolId])
  @@index([classId])
  @@index([sectionId])
}

// Deactivate, never delete — historical grading/attendance entries must
// remain attributable to a former staff member (master doc Section 8.6).
model Staff {
  id          String      @id @default(cuid())
  schoolId    String
  userId      String      @unique
  designation String
  joiningDate DateTime    @default(now())
  status      StaffStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user           User                @relation(fields: [userId], references: [id])
  assignments    TeacherAssignment[]
  timetableSlots TimetableSlot[]

  @@index([schoolId])
}

// Which class+section a teacher is assigned to teach — scopes their view of
// students and their ability to mark attendance to just those sections.
model TeacherAssignment {
  id        String   @id @default(cuid())
  schoolId  String
  staffId   String
  classId   String
  sectionId String
  createdAt DateTime @default(now())

  staff   Staff   @relation(fields: [staffId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])
  section Section @relation(fields: [sectionId], references: [id])

  @@unique([staffId, sectionId])
  @@index([schoolId])
  @@index([staffId])
  @@index([sectionId])
}

model Guardian {
  id        String   @id @default(cuid())
  schoolId  String
  userId    String   @unique
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User              @relation(fields: [userId], references: [id])
  students StudentGuardian[]

  @@index([schoolId])
}

// Join table instead of a single parentId — supports siblings sharing a
// guardian and a student having multiple guardians (master doc Section 8.6).
model StudentGuardian {
  id               String               @id @default(cuid())
  schoolId         String
  studentId        String
  guardianId       String
  relationshipType GuardianRelationship
  isPrimaryContact Boolean              @default(false)
  createdAt        DateTime             @default(now())

  student  Student  @relation(fields: [studentId], references: [id])
  guardian Guardian @relation(fields: [guardianId], references: [id])

  @@unique([studentId, guardianId])
  @@index([schoolId])
  @@index([guardianId])
}

// Excluded from attendance % — a holiday date is never counted as an absence
// (master doc Section 8.3).
model Holiday {
  id        String   @id @default(cuid())
  schoolId  String
  date      DateTime @db.Date
  name      String
  createdAt DateTime @default(now())

  @@unique([schoolId, date])
  @@index([schoolId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
}

// classId/sectionId are captured at the time of marking (not looked up live)
// so a student transferred mid-week keeps correct historical records instead
// of retroactively appearing to have always been in their new section —
// master doc Section 8.3.
model Attendance {
  id             String           @id @default(cuid())
  schoolId       String
  studentId      String
  classId        String
  sectionId      String
  date           DateTime         @db.Date
  status         AttendanceStatus
  remarks        String?
  markedByUserId String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  student  Student @relation(fields: [studentId], references: [id])
  class    Class   @relation(fields: [classId], references: [id])
  section  Section @relation(fields: [sectionId], references: [id])
  markedBy User    @relation("AttendanceMarkedBy", fields: [markedByUserId], references: [id])

  @@unique([studentId, date])
  @@index([schoolId])
  @@index([classId, sectionId, date])
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// Covers both staff and student leave (master doc Section C/E). role is
// snapshotted at request time so a later role change doesn't rewrite history.
// Approving a STUDENT request also upserts LEAVE attendance rows for the
// date range — see leaveRequest.service.ts.
model LeaveRequest {
  id           String      @id @default(cuid())
  schoolId     String
  userId       String
  role         Role
  leaveType    String
  startDate    DateTime    @db.Date
  endDate      DateTime    @db.Date
  reason       String
  status       LeaveStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user       User  @relation("LeaveRequestApplicant", fields: [userId], references: [id])
  reviewedBy User? @relation("LeaveRequestReviewer", fields: [reviewedById], references: [id])

  @@index([schoolId])
  @@index([userId])
  @@index([status])
}

// Null targetRole/targetClassId means school-wide; either or both narrow it —
// master doc Section G.
model Announcement {
  id            String   @id @default(cuid())
  schoolId      String
  title         String
  body          String
  targetRole    Role?
  targetClassId String?
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  targetClass Class? @relation(fields: [targetClassId], references: [id])
  creator     User   @relation("AnnouncementCreatedBy", fields: [createdBy], references: [id])

  @@index([schoolId])
  @@index([targetClassId])
}
