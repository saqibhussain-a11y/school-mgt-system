generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// One row today ("School #1"), but every tenant-scoped table below already
// carries schoolId — see the SaaS conversion plan in the master doc (Section 5/8.7).
model School {
  id                 String    @id @default(cuid())
  name               String
  subdomain          String    @unique
  subscriptionPlan   String    @default("single_tenant")
  subscriptionStatus String    @default("active")
  trialEndsAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  users User[]
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  PRINCIPAL
  TEACHER
  STUDENT
  PARENT
  ACCOUNTANT
  LIBRARIAN
  TRANSPORT_MANAGER
}

model User {
  id           String   @id @default(cuid())
  schoolId     String
  email        String
  passwordHash String
  role         Role
  firstName    String   @default("")
  lastName     String   @default("")
  // Defaults true for every existing flow (staff, guardians, admin-created
  // accounts) — only student admission sets this false at creation, with an
  // unusable placeholder passwordHash, so login is rejected until an admin
  // explicitly issues credentials (see student.service.ts's
  // generateCredentials). Flipped true whenever a real password is actually
  // set (admin-issued or self-service OTP claim).
  isActivated  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school              School             @relation(fields: [schoolId], references: [id])
  refreshTokens       RefreshToken[]
  passwordResetOtps   PasswordResetOtp[]
  student             Student?
  staff               Staff?
  guardian            Guardian?
  attendanceMarked    Attendance[]       @relation("AttendanceMarkedBy")
  announcements       Announcement[]     @relation("AnnouncementCreatedBy")
  leaveRequests       LeaveRequest[]     @relation("LeaveRequestApplicant")
  leaveReviews        LeaveRequest[]     @relation("LeaveRequestReviewer")
  marksEntered        Mark[]
  assignmentsCreated  Assignment[]       @relation("AssignmentCreatedBy")
  submissionsGraded   Submission[]       @relation("SubmissionGradedBy")
  notifications       Notification[]
  feeInvoicesCreated  FeeInvoice[]       @relation("FeeInvoiceCreatedBy")
  feePaymentsRecorded FeePayment[]       @relation("FeePaymentRecordedBy")
  feeRefundsRecorded  FeeRefund[]        @relation("FeeRefundRecordedBy")
  scholarshipsCreated Scholarship[]      @relation("ScholarshipCreatedBy")
  documentsIssued     IssuedDocument[]   @relation("DocumentIssuedBy")
  bookLoansIssued     BookLoan[]         @relation("BookLoanIssuedBy")

  @@unique([schoolId, email])
  @@index([schoolId])
}

// Rotated on every refresh; tokenHash lets a stolen DB dump not be a stolen session.
model RefreshToken {
  id        String    @id @default(cuid())
  schoolId  String
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([schoolId])
  @@index([userId])
}

model PasswordResetOtp {
  id         String    @id @default(cuid())
  schoolId   String
  userId     String
  otpHash    String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([schoolId])
  @@index([userId])
}

// Classes/Sections live inside a session so year-end promotion and repeated
// classes keep separate, correctly-dated records — see master doc Section 8.2.
model AcademicSession {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes      Class[]
  exams        Exam[]
  examSessions ExamSession[]
  examTerms    ExamTerm[]
  syllabuses   Syllabus[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

// Groups exams into a sequence within an academic session (Term 1 → Term 2
// → Final) so a later exam can optionally show earlier terms' marks
// side-by-side (see Exam.includePreviousTerms) — a school-wide sequence,
// not per-class; each class's own exam for that term links to the same row.
model ExamTerm {
  id                String   @id @default(cuid())
  schoolId          String
  academicSessionId String
  name              String
  order             Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id])
  exams           Exam[]

  @@unique([academicSessionId, order])
  @@index([schoolId])
}

model Class {
  id                String   @id @default(cuid())
  schoolId          String
  academicSessionId String
  name              String
  defaultRoomId     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  academicSession    AcademicSession     @relation(fields: [academicSessionId], references: [id])
  defaultRoom        Room?               @relation(fields: [defaultRoomId], references: [id])
  sections           Section[]
  subjects           Subject[]
  students           Student[]
  attendances        Attendance[]
  announcements      Announcement[]
  teacherAssignments TeacherAssignment[]
  timetableSlots     TimetableSlot[]
  exams              Exam[]
  assignments        Assignment[]
  feeStructures      FeeStructure[]
  syllabuses         Syllabus[]

  @@unique([academicSessionId, name])
  @@index([schoolId])
}

model Section {
  id        String   @id @default(cuid())
  schoolId  String
  classId   String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class              Class               @relation(fields: [classId], references: [id])
  students           Student[]
  attendances        Attendance[]
  teacherAssignments TeacherAssignment[]
  timetableSlots     TimetableSlot[]

  @@unique([classId, name])
  @@index([schoolId])
}

model Subject {
  id             String   @id @default(cuid())
  schoolId       String
  classId        String
  name           String
  periodsPerWeek Int      @default(1)
  requiresLab    Boolean  @default(false)
  roomId         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  class              Class                      @relation(fields: [classId], references: [id])
  room               Room?                      @relation(fields: [roomId], references: [id])
  timetableSlots     TimetableSlot[]
  examSubjects       ExamSubject[]
  assignments        Assignment[]
  teacherAssignments TeacherSubjectAssignment[]
  syllabuses         Syllabus[]

  @@unique([classId, name])
  @@index([schoolId])
}

// Groups several classes' per-class Exam rows into one combined "sitting"
// so they can share seating/invigilation across rooms — e.g. Grade 4's and
// Grade 5's Mid-Term. Exam.examSessionId is nullable and populated lazily
// (see examSeating.service.ts): most exams never need cross-class seating,
// so creating a session eagerly for every exam would be pure UI clutter.
// isAutoCreated marks the trivial 1:1 sessions the seating generator
// creates behind the scenes for a standalone exam, so the "combine with
// other classes" picker can filter them out.
model ExamSession {
  id                String          @id @default(cuid())
  schoolId          String
  academicSessionId String
  name              String
  startDate         DateTime        @db.Date
  endDate           DateTime        @db.Date
  isAutoCreated     Boolean         @default(false)
  // INTERLEAVED (the original round-robin generator) vs COLUMN_BLOCKED (fully
  // manual — admin assigns exact seat-range blocks per room column). Fixed
  // per session, not a school-wide mode: some schools want one, some the
  // other, and it's a genuinely different physical seat arrangement, not
  // just a different UI over the same model — see examSeating.service.ts.
  seatingStrategy   SeatingStrategy @default(INTERLEAVED)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  academicSession AcademicSession      @relation(fields: [academicSessionId], references: [id])
  exams           Exam[]
  seatAllocations ExamSeatAllocation[]
  invigilations   ExamInvigilation[]

  @@index([schoolId])
  @@index([academicSessionId])
}

enum SeatingStrategy {
  INTERLEAVED
  COLUMN_BLOCKED
}

enum ExamStatus {
  DRAFT
  PUBLISHED
}

// Percentage-only grading for this pass (master doc's GPA/custom-rubric
// options deferred — a school-configurable grading system is a bigger
// project on its own). See lib/grading.ts for the fixed letter-grade bands.
model Exam {
  id                   String     @id @default(cuid())
  schoolId             String
  classId              String
  academicSessionId    String
  examSessionId        String?
  name                 String
  startDate            DateTime   @db.Date
  endDate              DateTime   @db.Date
  // Gates the STUDENT/PARENT-facing report card only — TEACHER/SCHOOL_ADMIN/
  // PRINCIPAL always see raw marks regardless of status (see exam.route.ts's
  // assertCanViewReportCard vs. the extra STUDENT/PARENT-only status check).
  status               ExamStatus @default(DRAFT)
  // Informational deadline for teachers to finish entering marks — surfaced
  // on the admin dashboard's Needs Attention panel when overdue and
  // incomplete, never enforced as a hard block on late entry.
  marksDeadline        DateTime?  @db.Date
  examTermId           String?
  // Only meaningful when examTermId is set — shows earlier terms in this
  // sequence side-by-side on this exam's report card (see
  // exam.service.ts's getReportCard). No weighted/combined score, reference
  // only (master doc scenario notes: schools didn't agree on one formula).
  includePreviousTerms Boolean    @default(false)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  class           Class           @relation(fields: [classId], references: [id])
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id])
  examSession     ExamSession?    @relation(fields: [examSessionId], references: [id])
  examTerm        ExamTerm?       @relation(fields: [examTermId], references: [id])
  examSubjects    ExamSubject[]

  // Postgres treats multiple NULLs as distinct, so this only enforces "one
  // Exam per class per session" for actual session members — standalone
  // exams (examSessionId: null) are unaffected.
  @@unique([examSessionId, classId])
  @@index([schoolId])
  @@index([classId])
  @@index([examSessionId])
  @@index([examTermId])
}

// Which subjects are covered by an exam, and each one's max marks — set
// once at exam creation. Deliberately no update/remove-subject endpoint
// once marks exist against it (see exam.service.ts) to avoid orphaning Mark
// rows silently. examDate/startTime/endTime are the per-paper datesheet —
// free-form "HH:mm" strings like Period, but deliberately NOT linked to
// Period: exam blocks run longer than a regular class period and aren't
// grid-aligned. All three are nullable so "exam created, datesheet not set
// yet" is a valid, expected interim state.
model ExamSubject {
  id        String    @id @default(cuid())
  schoolId  String
  examId    String
  subjectId String
  maxMarks  Int
  examDate  DateTime? @db.Date
  startTime String?
  endTime   String?

  exam    Exam    @relation(fields: [examId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  marks   Mark[]

  @@unique([examId, subjectId])
  // Postgres treats multiple NULLs as distinct, so unscheduled subjects
  // (examDate: null) are never constrained against each other — only two
  // subjects genuinely sharing a real day for the same exam collide.
  @@unique([examId, examDate])
  @@index([schoolId])
  @@index([schoolId, examDate])
}

// isAbsent is separate from marksObtained=0 — a student absent from an exam
// must never be scored as zero, it skews the class average (master doc
// §8.4). marksObtained is null until entered, distinguishing "not yet
// marked" from "scored zero".
model Mark {
  id              String   @id @default(cuid())
  schoolId        String
  examSubjectId   String
  studentId       String
  marksObtained   Float?
  isAbsent        Boolean  @default(false)
  enteredByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  examSubject ExamSubject @relation(fields: [examSubjectId], references: [id])
  student     Student     @relation(fields: [studentId], references: [id])
  enteredBy   User        @relation(fields: [enteredByUserId], references: [id])

  @@unique([examSubjectId, studentId])
  @@index([schoolId])
  @@index([studentId])
}

// Class-scoped like Exam (Subject has no teacher mapping — see
// getAssignedClassIdsForUser). attachmentKey is an object-storage key, never
// a public URL — files are private, served only via a short-lived presigned
// GET through assignment.service.ts (see lib/storage.ts).
model Assignment {
  id                 String   @id @default(cuid())
  schoolId           String
  classId            String
  subjectId          String
  title              String
  description        String?
  dueDate            DateTime
  maxMarks           Int      @default(100)
  attachmentKey      String?
  attachmentFilename String?
  createdByUserId    String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  class       Class        @relation(fields: [classId], references: [id])
  subject     Subject      @relation(fields: [subjectId], references: [id])
  createdBy   User         @relation("AssignmentCreatedBy", fields: [createdByUserId], references: [id])
  submissions Submission[]

  @@index([schoolId])
  @@index([classId])
}

// One submission per student per assignment — resubmission before grading
// overwrites it (upsert), no version history. textAnswer and fileKey are
// both optional and independent: a student can type an answer, attach a
// file, or both.
model Submission {
  id             String    @id @default(cuid())
  schoolId       String
  assignmentId   String
  studentId      String
  textAnswer     String?
  fileKey        String?
  fileFilename   String?
  submittedAt    DateTime  @default(now())
  marksObtained  Float?
  feedback       String?
  gradedByUserId String?
  gradedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  student    Student    @relation(fields: [studentId], references: [id])
  gradedBy   User?      @relation("SubmissionGradedBy", fields: [gradedByUserId], references: [id])

  @@unique([assignmentId, studentId])
  @@index([schoolId])
  @@index([studentId])
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum RoomType {
  GENERAL
  LAB
}

// A school's physical rooms — the auto-generator's room-conflict/lab-room
// constraints are checked against this, not against Class directly (a class
// can have a defaultRoomId, but many sections/subjects can share the pool).
model Room {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  type      RoomType @default(GENERAL)
  capacity  Int? // Seats. Shared by exam seating (bulk-generate requires it; manual seat entry tolerates null) and the timetable generator's room-fits-section advisory (never blocks generation, only null is ever ambiguous).
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classesDefaultingHere Class[]
  subjects              Subject[]
  timetableSlots        TimetableSlot[]
  examSeatAllocations   ExamSeatAllocation[]
  examInvigilations     ExamInvigilation[]
  columns               RoomColumn[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

// Optional per-room column layout for COLUMN_BLOCKED exam seating — a room
// with no columns configured can only ever be used with the INTERLEAVED
// strategy. Configured once per room and reused across every exam session,
// same as Room.capacity itself.
model RoomColumn {
  id           String   @id @default(cuid())
  schoolId     String
  roomId       String
  columnNumber Int
  seatCapacity Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  room            Room                 @relation(fields: [roomId], references: [id], onDelete: Cascade)
  seatAllocations ExamSeatAllocation[]

  @@unique([roomId, columnNumber])
  @@index([schoolId])
}

// One school-wide daily period grid (same periods every working day).
// periodNumber is the ordinal the rest of the system schedules against
// (teacher availability ranges, TimetableSlot.periodId) — isBreak periods
// (e.g. lunch) are skipped by the generator, never scheduled into.
model Period {
  id           String   @id @default(cuid())
  schoolId     String
  periodNumber Int
  startTime    String
  endTime      String
  isBreak      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  timetableSlots TimetableSlot[]

  @@unique([schoolId, periodNumber])
  @@index([schoolId])
}

// Which subjects a teacher is qualified to teach — deliberately separate
// from TeacherAssignment (which scopes attendance-marking/student
// visibility to a class+section, an unrelated concern). Subject is already
// per-Class, so "teaches Math for Grade 4 and Grade 5" is naturally two rows
// here (one per Subject row) rather than a separate grade/class field.
model TeacherSubjectAssignment {
  id        String   @id @default(cuid())
  schoolId  String
  staffId   String
  subjectId String
  createdAt DateTime @default(now())

  staff   Staff   @relation(fields: [staffId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([staffId, subjectId])
  @@index([schoolId])
  @@index([staffId])
  @@index([subjectId])
}

// Curriculum pacing plan: admin lays out which chapter a class+subject covers
// and when, for a given academic session. One row per Class+Subject+Session —
// Subject is already class-scoped, but classId is kept explicit here for the
// same query-shape symmetry Exam/TimetableSlot use elsewhere in this schema.
model Syllabus {
  id                String   @id @default(cuid())
  schoolId          String
  classId           String
  subjectId         String
  academicSessionId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  class           Class           @relation(fields: [classId], references: [id])
  subject         Subject         @relation(fields: [subjectId], references: [id])
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id])
  chapters        Chapter[]

  @@unique([classId, subjectId, academicSessionId])
  @@index([schoolId])
}

model Chapter {
  id         String   @id @default(cuid())
  schoolId   String
  syllabusId String
  title      String
  order      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  syllabus        Syllabus        @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  scheduleEntries ScheduleEntry[]

  @@unique([syllabusId, order])
  @@index([schoolId])
}

// Deliberately one flexible shape for both a single-day plan and a
// week/month-long whole-chapter plan — the difference is only how wide the
// admin sets the date range, never a separate model or a school-level mode flag.
model ScheduleEntry {
  id        String   @id @default(cuid())
  schoolId  String
  chapterId String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([chapterId])
}

enum TimetableSlotSource {
  GENERATED
  MANUAL
}

// Auto-generated by default (timetableGenerator.service.ts); source flips to
// MANUAL the moment a slot is hand-edited, so a future regenerate action can
// tell "the generator wrote this" apart from "an admin deliberately fixed
// this" without destroying edits. periodId/roomId replace the old free-form
// startTime/endTime strings now that Period is a shared entity.
model TimetableSlot {
  id        String              @id @default(cuid())
  schoolId  String
  classId   String
  sectionId String
  subjectId String
  staffId   String
  dayOfWeek DayOfWeek
  periodId  String
  roomId    String
  source    TimetableSlotSource @default(MANUAL)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  class   Class   @relation(fields: [classId], references: [id])
  section Section @relation(fields: [sectionId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  staff   Staff   @relation(fields: [staffId], references: [id])
  period  Period  @relation(fields: [periodId], references: [id])
  room    Room    @relation(fields: [roomId], references: [id])

  @@index([schoolId])
  @@index([sectionId, dayOfWeek])
  @@index([staffId, dayOfWeek])
  @@index([roomId, dayOfWeek])
}

// Deliberately separate from TimetableSlotSource so a future timetable-only
// change can't accidentally affect exam seating/invigilation code.
enum ExamAssignmentSource {
  GENERATED
  MANUAL
}

// A student's fixed room+seat for one whole ExamSession, reused across
// every paper in that session (not reassigned per date) — matches how
// schools actually run a multi-day sitting and avoids the much harder
// problem of room composition varying day-to-day. classId/sectionId are a
// snapshot at seating time, same rationale as Attendance.classId/sectionId:
// correct-as-recorded even if the student is later transferred, and lets
// the seat chart group by class with no extra join.
model ExamSeatAllocation {
  id            String               @id @default(cuid())
  schoolId      String
  examSessionId String
  studentId     String
  classId       String
  sectionId     String
  roomId        String
  // Set only for COLUMN_BLOCKED seating — null for INTERLEAVED rows, where
  // seatNumber is still room-wide as before. For a column-blocked row,
  // seatNumber is relative to the column (1..RoomColumn.seatCapacity), not
  // the room — matches how an admin actually describes a block ("Column 3,
  // seats 1-5"). This is why the seat-uniqueness constraint below is scoped
  // by columnId rather than reusing the old room-wide one: Postgres treats a
  // NULL columnId as never equal to another NULL, so a 4-column unique index
  // can't also guard the INTERLEAVED (columnId-always-null) rows — that path
  // keeps relying on the application-level dedup it already had
  // (interleaveByGroup's in-memory fill order, assignSeat's explicit
  // collision check), same as before this field existed.
  columnId      String?
  seatNumber    Int
  source        ExamAssignmentSource @default(GENERATED)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  examSession ExamSession @relation(fields: [examSessionId], references: [id])
  student     Student     @relation(fields: [studentId], references: [id])
  room        Room        @relation(fields: [roomId], references: [id])
  column      RoomColumn? @relation(fields: [columnId], references: [id])

  @@unique([examSessionId, studentId])
  @@unique([examSessionId, roomId, columnId, seatNumber])
  @@index([schoolId])
  @@index([roomId])
  @@index([columnId])
}

// Coverage slots (room + date + time-window) are derived at generation
// time from seated students' scheduled papers, not modeled separately — an
// invigilator covers a room regardless of which subject is being written.
// endTime is part of the unique key alongside startTime because two
// distinct time-windows for the same room+date, while unusual, aren't
// impossible (e.g. a morning and an afternoon shift).
model ExamInvigilation {
  id            String               @id @default(cuid())
  schoolId      String
  examSessionId String
  staffId       String
  roomId        String
  examDate      DateTime             @db.Date
  startTime     String
  endTime       String
  source        ExamAssignmentSource @default(GENERATED)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  examSession ExamSession @relation(fields: [examSessionId], references: [id])
  staff       Staff       @relation(fields: [staffId], references: [id])
  room        Room        @relation(fields: [roomId], references: [id])

  @@unique([examSessionId, roomId, examDate, startTime, endTime, staffId])
  @@index([schoolId])
  @@index([staffId, examDate])
  @@index([roomId, examDate])
}

enum StudentStatus {
  ACTIVE
  WITHDRAWN
}

enum StaffStatus {
  ACTIVE
  DEACTIVATED
}

enum GuardianRelationship {
  FATHER
  MOTHER
  GRANDPARENT
  LEGAL_GUARDIAN
  OTHER
}

// Withdrawal is a status change, never a row delete — historical attendance/
// grades/payments must stay attributable (master doc Section 8.1).
model Student {
  id             String        @id @default(cuid())
  schoolId       String
  userId         String        @unique
  admissionNo    String
  classId        String
  sectionId      String
  dob            DateTime
  admissionDate  DateTime      @default(now())
  previousSchool String?
  medicalInfo    String?
  status         StudentStatus @default(ACTIVE)
  // Free-form school-defined fields captured from bulk-import columns that
  // don't map to a known field (e.g. a legacy system's own custom column) —
  // keyed by the original CSV header. Not integrated into search/reports,
  // just preserved so nothing from the source file is silently dropped.
  extraInfo      Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user                User                 @relation(fields: [userId], references: [id])
  class               Class                @relation(fields: [classId], references: [id])
  section             Section              @relation(fields: [sectionId], references: [id])
  guardians           StudentGuardian[]
  attendances         Attendance[]
  marks               Mark[]
  submissions         Submission[]
  feeInvoices         FeeInvoice[]
  scholarships        Scholarship[]
  issuedDocuments     IssuedDocument[]
  bookLoans           BookLoan[]
  bookReservations    BookReservation[]
  routeAssignment     StudentRoute?
  examSeatAllocations ExamSeatAllocation[]

  @@unique([schoolId, admissionNo])
  @@index([schoolId])
  @@index([classId])
  @@index([sectionId])
}

// Per-school admission-number pattern, so a school migrating from a legacy
// system can continue its own numbering instead of getting our fixed
// ADM-{year}-{seq} scheme. Lazy-upserted on first read, same pattern as
// LeavePolicy. nextNumber is a plain counter (no year-rollover) — a school
// that wants year segments just edits the prefix themselves; this only
// auto-advances forward (see student.service.ts's advanceIfNeeded), never
// resets.
model AdmissionNumberFormat {
  id         String   @id @default(cuid())
  schoolId   String   @unique
  prefix     String   @default("ADM-")
  nextNumber Int      @default(1)
  padWidth   Int      @default(4)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([schoolId])
}

// Remembers how this school last mapped their CSV's column headers to our
// known student fields, so a repeat bulk import from the same legacy export
// doesn't need to be re-mapped by hand every time. One row per school,
// overwritten on every import.
model StudentImportMapping {
  id        String   @id @default(cuid())
  schoolId  String   @unique
  // { csvHeader: targetField | null } — null means "keep in extraInfo".
  mapping   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

// Deactivate, never delete — historical grading/attendance entries must
// remain attributable to a former staff member (master doc Section 8.6).
model Staff {
  id                   String      @id @default(cuid())
  schoolId             String
  userId               String      @unique
  designation          String
  joiningDate          DateTime    @default(now())
  status               StaffStatus @default(ACTIVE)
  // Timetable-generation availability — flat weekly values (not per-subject,
  // not per-day): one teacher can't have two different availabilities at
  // once, and this matches the spec's own "Monday-Saturday, periods 1-8"
  // shape. This is the schema's first native Postgres array column (every
  // other multi-value relationship here is a join table) — deliberate, not
  // an oversight, since it's the same shape a future substitute-teacher
  // finder would want to query with `hasSome`.
  workingDays          DayOfWeek[]
  periodsAvailableFrom Int?
  periodsAvailableTo   Int?
  maxPeriodsPerWeek    Int?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  user               User                       @relation(fields: [userId], references: [id])
  assignments        TeacherAssignment[]
  subjectAssignments TeacherSubjectAssignment[]
  timetableSlots     TimetableSlot[]
  examInvigilations  ExamInvigilation[]

  @@index([schoolId])
}

// Which class+section a teacher is assigned to teach — scopes their view of
// students and their ability to mark attendance to just those sections.
model TeacherAssignment {
  id        String   @id @default(cuid())
  schoolId  String
  staffId   String
  classId   String
  sectionId String
  createdAt DateTime @default(now())

  staff   Staff   @relation(fields: [staffId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])
  section Section @relation(fields: [sectionId], references: [id])

  @@unique([staffId, sectionId])
  @@index([schoolId])
  @@index([staffId])
  @@index([sectionId])
}

model Guardian {
  id        String   @id @default(cuid())
  schoolId  String
  userId    String   @unique
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User              @relation(fields: [userId], references: [id])
  students StudentGuardian[]

  @@index([schoolId])
}

// Join table instead of a single parentId — supports siblings sharing a
// guardian and a student having multiple guardians (master doc Section 8.6).
model StudentGuardian {
  id               String               @id @default(cuid())
  schoolId         String
  studentId        String
  guardianId       String
  relationshipType GuardianRelationship
  isPrimaryContact Boolean              @default(false)
  createdAt        DateTime             @default(now())

  student  Student  @relation(fields: [studentId], references: [id])
  guardian Guardian @relation(fields: [guardianId], references: [id])

  @@unique([studentId, guardianId])
  @@index([schoolId])
  @@index([guardianId])
}

// Excluded from attendance % — a holiday date is never counted as an absence
// (master doc Section 8.3).
model Holiday {
  id        String   @id @default(cuid())
  schoolId  String
  date      DateTime @db.Date
  name      String
  createdAt DateTime @default(now())

  @@unique([schoolId, date])
  @@index([schoolId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
}

// classId/sectionId are captured at the time of marking (not looked up live)
// so a student transferred mid-week keeps correct historical records instead
// of retroactively appearing to have always been in their new section —
// master doc Section 8.3.
model Attendance {
  id             String           @id @default(cuid())
  schoolId       String
  studentId      String
  classId        String
  sectionId      String
  date           DateTime         @db.Date
  status         AttendanceStatus
  remarks        String?
  markedByUserId String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  student  Student @relation(fields: [studentId], references: [id])
  class    Class   @relation(fields: [classId], references: [id])
  section  Section @relation(fields: [sectionId], references: [id])
  markedBy User    @relation("AttendanceMarkedBy", fields: [markedByUserId], references: [id])

  @@unique([studentId, date])
  @@index([schoolId])
  @@index([classId, sectionId, date])
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// Covers both staff and student leave (master doc Section C/E). role is
// snapshotted at request time so a later role change doesn't rewrite history.
// Approving a STUDENT request also upserts LEAVE attendance rows for the
// date range — see leaveRequest.service.ts.
model LeaveRequest {
  id           String      @id @default(cuid())
  schoolId     String
  userId       String
  role         Role
  leaveType    String
  startDate    DateTime    @db.Date
  endDate      DateTime    @db.Date
  reason       String
  status       LeaveStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user       User  @relation("LeaveRequestApplicant", fields: [userId], references: [id])
  reviewedBy User? @relation("LeaveRequestReviewer", fields: [reviewedById], references: [id])

  @@index([schoolId])
  @@index([userId])
  @@index([status])
}

// One row per school. Annual entitlement in days for each fixed leave type;
// lazily upserted with these defaults on first access rather than backfilled,
// so existing schools never need a data migration to get a row.
model LeavePolicy {
  id         String   @id @default(cuid())
  schoolId   String
  sickDays   Int      @default(10)
  casualDays Int      @default(8)
  otherDays  Int      @default(5)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([schoolId])
}

// In-app notification, pushed over Socket.io on creation and persisted so a
// user still sees it after reconnecting/refreshing. type is a free-form
// event tag (e.g. "announcement", "assignment", "grade", "leave_request",
// "leave_review") the frontend uses to pick an icon — no enum, since new
// event types shouldn't require a migration.
model Notification {
  id        String   @id @default(cuid())
  schoolId  String
  userId    String
  type      String
  title     String
  body      String?
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([schoolId])
  @@index([userId, isRead])
}

// Null targetRole/targetClassId means school-wide; either or both narrow it —
// master doc Section G.
model Announcement {
  id            String   @id @default(cuid())
  schoolId      String
  title         String
  body          String
  targetRole    Role?
  targetClassId String?
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  targetClass Class? @relation(fields: [targetClassId], references: [id])
  creator     User   @relation("AnnouncementCreatedBy", fields: [createdBy], references: [id])

  @@index([schoolId])
  @@index([targetClassId])
}

// A reusable per-class template (e.g. "Grade 5 / tuition = $500"), not a
// one-time invoice — invoices snapshot `amount` at generation time (see
// FeeInvoice), so editing a structure's amount later never retroactively
// changes students already invoiced (master doc §8.5).
model FeeStructure {
  id        String   @id @default(cuid())
  schoolId  String
  classId   String
  category  String
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class    Class        @relation(fields: [classId], references: [id])
  invoices FeeInvoice[]

  @@unique([classId, category])
  @@index([schoolId])
}

enum FeeInvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

// CREDIT payments are how the derived fee-credit pool is "spent" — see
// feeLedger.ts's creditPoolFor(). A payment's method must stay constrained
// (not a free string) because that math depends on it.
enum FeePaymentMethod {
  MANUAL
  CREDIT
}

// period is a free-form label ("September 2026", "Term 1") the accountant
// supplies at generation time — invoicing is manual/on-demand (no
// scheduler in this codebase), not an auto-recurring billing cycle.
// amount is snapshotted from FeeStructure; netAmount = amount -
// discountAmount. status is recomputed (not just derived at read time)
// whenever a payment/refund is recorded, so list/report queries stay cheap.
model FeeInvoice {
  id              String           @id @default(cuid())
  schoolId        String
  studentId       String
  feeStructureId  String
  period          String
  amount          Float
  discountAmount  Float            @default(0)
  netAmount       Float
  dueDate         DateTime         @db.Date
  status          FeeInvoiceStatus @default(UNPAID)
  createdByUserId String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  student      Student      @relation(fields: [studentId], references: [id])
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id])
  createdBy    User         @relation("FeeInvoiceCreatedBy", fields: [createdByUserId], references: [id])
  payments     FeePayment[]

  @@unique([studentId, feeStructureId, period])
  @@index([schoolId])
  @@index([studentId])
  // Backs the overdue filter (feeInvoice.service.ts's list()) and the
  // fee-collection trend chart's month bucketing (reports.service.ts) —
  // both filter/sort by dueDate scoped to a school; previously an unindexed
  // full scan.
  @@index([schoolId, dueDate])
}

model FeePayment {
  id               String           @id @default(cuid())
  schoolId         String
  invoiceId        String
  amountPaid       Float
  paymentMethod    FeePaymentMethod @default(MANUAL)
  referenceNote    String?
  paymentDate      DateTime         @default(now())
  recordedByUserId String
  // Client-generated, one per submission attempt (regenerated only when the
  // user starts a genuinely new one) — a retried/double-clicked request
  // replays the same key and returns the original payment instead of
  // creating a second one. Null for payment rows created any other way
  // (applyCredit, seed data) — Postgres treats each NULL as distinct, so
  // those never collide with each other or with a real key.
  idempotencyKey   String?
  createdAt        DateTime         @default(now())

  invoice    FeeInvoice  @relation(fields: [invoiceId], references: [id])
  recordedBy User        @relation("FeePaymentRecordedBy", fields: [recordedByUserId], references: [id])
  refunds    FeeRefund[]

  @@unique([schoolId, idempotencyKey])
  @@index([schoolId])
  @@index([invoiceId])
}

// A refund is its own row (never a mutation/deletion of the original
// payment) so the ledger stays an honest, append-only history — master doc
// §8.5's "refunds need a dedicated workflow, never just deleting the
// payment record."
model FeeRefund {
  id               String   @id @default(cuid())
  schoolId         String
  paymentId        String
  amount           Float
  reason           String
  recordedByUserId String
  createdAt        DateTime @default(now())

  payment    FeePayment @relation(fields: [paymentId], references: [id])
  recordedBy User       @relation("FeeRefundRecordedBy", fields: [recordedByUserId], references: [id])

  @@index([schoolId])
  @@index([paymentId])
}

enum ScholarshipDiscountType {
  PERCENTAGE
  FLAT
}

// A standing per-student discount policy, not a money-movement event (unlike
// FeeRefund, which is deliberately append-only) — a scholarship is an
// editable-in-place rate, the same "admin edits a policy row" shape as
// LeavePolicy. Scoped to one fee category (matching FeeStructure.category,
// e.g. "tuition") rather than a nullable applies-to-everything wildcard.
// feeInvoiceService.generate() auto-computes FeeInvoice.discountAmount from
// this when it generates an invoice in the matching category for this
// student — applies going forward only, matching FeeStructure's existing
// snapshot-at-generation-time philosophy (master doc §8.5).
model Scholarship {
  id              String                  @id @default(cuid())
  schoolId        String
  studentId       String
  category        String
  discountType    ScholarshipDiscountType
  discountValue   Float
  createdByUserId String
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  student   Student @relation(fields: [studentId], references: [id])
  createdBy User    @relation("ScholarshipCreatedBy", fields: [createdByUserId], references: [id])

  @@unique([studentId, category])
  @@index([schoolId])
}

// An audit record of an issued certificate, not just a generated file —
// schools need to know a TC/character certificate WAS issued, to whom, by
// whom, and when (master doc's document-issuance sensibility). The PDF
// itself is stored via lib/storage.ts (same R2/local-disk pattern as
// Assignments) so it can be re-downloaded without regenerating; `fields`
// snapshots the type-specific inputs (reason/conduct/purpose) used at
// generation time so a reprint always matches what was originally issued.
model IssuedDocument {
  id             String   @id @default(cuid())
  schoolId       String
  studentId      String
  type           String
  fileKey        String
  fileFilename   String
  fields         Json?
  issuedByUserId String
  issuedAt       DateTime @default(now())
  // Nullable — existing rows predate this column and were never backfilled
  // (it was previously computed inline, embedded in the PDF, and never
  // persisted at all). Postgres treats every NULL as distinct in the unique
  // index below, so those old rows never collide with anything.
  certificateNo  String?

  student  Student @relation(fields: [studentId], references: [id])
  issuedBy User    @relation("DocumentIssuedBy", fields: [issuedByUserId], references: [id])

  @@unique([schoolId, certificateNo])
  @@index([schoolId])
  @@index([studentId])
}

// One reusable calibration per school, not per class — a school's physical
// pre-printed result card is the same stock across every class, subject
// names already printed on it. markers is a flat, order-independent array of
// { id, fieldKey, xRatio, yRatio, fontSize? }, positions stored as 0-1
// ratios (resolution-independent) — fieldKey is one of the fixed keys
// ("studentName", "admissionNo", "classSection", "overallPercentage",
// "overallGrade", "rank") or a slot-indexed subject key
// ("subjectObtained:1", "subjectTotal:1", "subjectObtained:2", ...). Slots
// are positional, not tied to a real Subject/subjectId, precisely because
// the same template is reused across classes with different subject lists —
// see resultCardPdf.ts for how a specific exam's ordered subject list maps
// onto however many slots the admin calibrated. Deliberately NOT reusing
// IssuedDocument.fields — that column snapshots values typed into one
// already-generated document, this is a reusable layout definition many
// students' cards are later rendered from.
model ResultCardTemplate {
  id            String   @id @default(cuid())
  schoolId      String   @unique
  imageKey      String
  imageFilename String
  markers       Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([schoolId])
}

// availableCopies is decremented/incremented directly on issue/return
// (never derived at read-time) so catalog list queries stay cheap — same
// persisted-counter pattern as FeeInvoice.status.
model Book {
  id              String   @id @default(cuid())
  schoolId        String
  isbn            String?
  title           String
  author          String
  category        String?
  totalCopies     Int
  availableCopies Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  loans        BookLoan[]
  reservations BookReservation[]

  @@index([schoolId])
}

enum BookLoanStatus {
  ACTIVE
  RETURNED
  LOST
}

// fine is computed once at return time (days late * a fixed per-day rate,
// see library.constants.ts) and persisted — never recomputed on later
// reads, so it doesn't silently grow just from viewing an already-returned
// loan. dueDate defaults to issueDate + a fixed loan period (same file).
model BookLoan {
  id             String         @id @default(cuid())
  schoolId       String
  bookId         String
  studentId      String
  issueDate      DateTime       @default(now())
  dueDate        DateTime       @db.Date
  returnDate     DateTime?
  fine           Float          @default(0)
  finePaid       Boolean        @default(false)
  status         BookLoanStatus @default(ACTIVE)
  issuedByUserId String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  book     Book    @relation(fields: [bookId], references: [id])
  student  Student @relation(fields: [studentId], references: [id])
  issuedBy User    @relation("BookLoanIssuedBy", fields: [issuedByUserId], references: [id])

  @@index([schoolId])
  @@index([bookId])
  @@index([studentId])
}

enum BookReservationStatus {
  PENDING
  READY
  FULFILLED
  CANCELLED
}

// A simple first-in-line queue for books with zero available copies:
// PENDING -> READY (a copy freed up and the student was notified; not a
// hold — first to actually check it out gets it) -> FULFILLED (a BookLoan
// was issued to this same student+book) or CANCELLED.
model BookReservation {
  id         String                @id @default(cuid())
  schoolId   String
  bookId     String
  studentId  String
  status     BookReservationStatus @default(PENDING)
  reservedAt DateTime              @default(now())
  notifiedAt DateTime?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  book    Book    @relation(fields: [bookId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@index([schoolId])
  @@index([bookId])
  @@index([studentId])
}

// Driver is deliberately just contact fields, not a Staff/User account —
// there's no DRIVER role, drivers aren't expected to use the app. Live GPS
// tracking and pickup/drop notifications were explicitly scoped out of this
// pass (see sms_transport_management memory) — this is routes/vehicles/
// student-mapping only.
model Vehicle {
  id             String   @id @default(cuid())
  schoolId       String
  registrationNo String
  capacity       Int
  driverName     String
  driverPhone    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  routes Route[]

  @@unique([schoolId, registrationNo])
  @@index([schoolId])
}

model Route {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  vehicleId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle       Vehicle        @relation(fields: [vehicleId], references: [id])
  studentRoutes StudentRoute[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([vehicleId])
}

// One active route per student — @@unique([studentId]) rather than a
// history table, since without live tracking/notifications there's no
// event stream that needs a past-assignment record; changing a student's
// route is a delete-and-recreate, same simplicity level as the rest of
// this pass.
model StudentRoute {
  id         String   @id @default(cuid())
  schoolId   String
  studentId  String
  routeId    String
  pickupStop String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id])
  route   Route   @relation(fields: [routeId], references: [id])

  @@unique([studentId])
  @@index([schoolId])
  @@index([routeId])
}
