generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// One row today ("School #1"), but every tenant-scoped table below already
// carries schoolId — see the SaaS conversion plan in the master doc (Section 5/8.7).
model School {
  id                 String   @id @default(cuid())
  name               String
  subdomain          String   @unique
  subscriptionPlan   String   @default("single_tenant")
  subscriptionStatus String   @default("active")
  trialEndsAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users User[]
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  PRINCIPAL
  TEACHER
  STUDENT
  PARENT
  ACCOUNTANT
  LIBRARIAN
  TRANSPORT_MANAGER
}

model User {
  id           String   @id @default(cuid())
  schoolId     String
  email        String
  passwordHash String
  role         Role
  firstName    String   @default("")
  lastName     String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school            School             @relation(fields: [schoolId], references: [id])
  refreshTokens      RefreshToken[]
  passwordResetOtps  PasswordResetOtp[]
  student            Student?
  staff              Staff?
  guardian           Guardian?

  @@unique([schoolId, email])
  @@index([schoolId])
}

// Rotated on every refresh; tokenHash lets a stolen DB dump not be a stolen session.
model RefreshToken {
  id         String    @id @default(cuid())
  schoolId   String
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([schoolId])
  @@index([userId])
}

model PasswordResetOtp {
  id          String    @id @default(cuid())
  schoolId    String
  userId      String
  otpHash     String
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([schoolId])
  @@index([userId])
}

// Classes/Sections live inside a session so year-end promotion and repeated
// classes keep separate, correctly-dated records — see master doc Section 8.2.
model AcademicSession {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes Class[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Class {
  id                String   @id @default(cuid())
  schoolId          String
  academicSessionId String
  name              String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id])
  sections        Section[]
  subjects        Subject[]
  students        Student[]

  @@unique([academicSessionId, name])
  @@index([schoolId])
}

model Section {
  id        String   @id @default(cuid())
  schoolId  String
  classId   String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class    Class     @relation(fields: [classId], references: [id])
  students Student[]

  @@unique([classId, name])
  @@index([schoolId])
}

model Subject {
  id        String   @id @default(cuid())
  schoolId  String
  classId   String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class Class @relation(fields: [classId], references: [id])

  @@unique([classId, name])
  @@index([schoolId])
}

enum StudentStatus {
  ACTIVE
  WITHDRAWN
}

enum StaffStatus {
  ACTIVE
  DEACTIVATED
}

enum GuardianRelationship {
  FATHER
  MOTHER
  GRANDPARENT
  LEGAL_GUARDIAN
  OTHER
}

// Withdrawal is a status change, never a row delete — historical attendance/
// grades/payments must stay attributable (master doc Section 8.1).
model Student {
  id             String        @id @default(cuid())
  schoolId       String
  userId         String        @unique
  admissionNo    String
  classId        String
  sectionId      String
  dob            DateTime
  admissionDate  DateTime      @default(now())
  previousSchool String?
  medicalInfo    String?
  status         StudentStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user      User              @relation(fields: [userId], references: [id])
  class     Class             @relation(fields: [classId], references: [id])
  section   Section           @relation(fields: [sectionId], references: [id])
  guardians StudentGuardian[]

  @@unique([schoolId, admissionNo])
  @@index([schoolId])
  @@index([classId])
  @@index([sectionId])
}

// Deactivate, never delete — historical grading/attendance entries must
// remain attributable to a former staff member (master doc Section 8.6).
model Staff {
  id          String      @id @default(cuid())
  schoolId    String
  userId      String      @unique
  designation String
  joiningDate DateTime    @default(now())
  status      StaffStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([schoolId])
}

model Guardian {
  id        String   @id @default(cuid())
  schoolId  String
  userId    String   @unique
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User              @relation(fields: [userId], references: [id])
  students StudentGuardian[]

  @@index([schoolId])
}

// Join table instead of a single parentId — supports siblings sharing a
// guardian and a student having multiple guardians (master doc Section 8.6).
model StudentGuardian {
  id               String               @id @default(cuid())
  schoolId         String
  studentId        String
  guardianId       String
  relationshipType GuardianRelationship
  isPrimaryContact Boolean              @default(false)
  createdAt        DateTime             @default(now())

  student  Student  @relation(fields: [studentId], references: [id])
  guardian Guardian @relation(fields: [guardianId], references: [id])

  @@unique([studentId, guardianId])
  @@index([schoolId])
  @@index([guardianId])
}
