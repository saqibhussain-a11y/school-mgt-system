PORT=4000
NODE_ENV=development

DATABASE_URL="postgresql://sms:sms_dev_password@localhost:5432/sms_dev"
REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_PLATFORM_ACCESS_SECRET="change-me-platform-access"
JWT_PLATFORM_REFRESH_SECRET="change-me-platform-refresh"

CORS_ORIGIN="http://localhost:3000"

WEB_APP_URL="http://localhost:3000"
API_BASE_URL="http://localhost:4000"

# SMTP is optional in dev — leave SMTP_HOST unset and a disposable Ethereal
# inbox is auto-provisioned, with preview links logged to the API console.
# Fill these in to send through a real mailbox (e.g. SendGrid, Mailgun, Gmail SMTP).
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="School Management System <no-reply@yourschool.test>"

# Object storage (assignment attachments/submissions) is optional in dev —
# leave R2_ACCOUNT_ID unset and files are written to apps/api/uploads/ on
# local disk instead, served back through /api/uploads/local.
# Fill these in to use Cloudflare R2 (S3-compatible, zero egress fees):
# create a bucket + an R2 API token in the Cloudflare dashboard.
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""

# Online fee payment (Stripe) is optional — leave both unset and the
# "Pay now" flow returns a clean 501 instead of crashing. Get a free test
# secret key at dashboard.stripe.com (test mode, no card required); the
# webhook secret comes from `stripe listen` in local dev, or a real
# registered endpoint in production. See apps/api/src/lib/stripe.ts.
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# AI features (report summaries, the at-risk-student flagging report, and
# the parent/student chatbot) are optional — leave LLM_PROVIDER unset and
# they return a clean 501 instead of crashing. Pick one provider and set
# its key; Groq and Gemini both have genuinely free tiers (no card
# required). See apps/api/src/lib/llm/index.ts.
# LLM_PROVIDER=""              # groq | gemini | anthropic | openai | ollama
# GROQ_API_KEY=""
# GROQ_MODEL="openai/gpt-oss-120b"
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.0-flash"
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-5"
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"
# OLLAMA_BASE_URL="http://localhost:11434"   # a local, fully free, self-hosted model — no key needed
# OLLAMA_MODEL="llama3.1"
